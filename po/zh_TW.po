msgstr "已整合：%1"

#: src/cli/main.cpp:73
msgid "Usage: miryu-app-launcher-cli unintegrate <path...>"
msgstr "用法：miryu-app-launcher-cli unintegrate <路徑...>"

#: src/cli/main.cpp:83
msgid "Unintegrated: %1"
msgstr "已取消整合：%1"

#: src/cli/main.cpp:85
msgid "Failed to unintegrate %1"
msgstr "取消整合 %1 失敗"

#: src/cli/main.cpp:120
msgid "Removed stale entry: %1"
msgstr "已移除過時條目：%1"

#: src/cli/main.cpp:127
msgid "Removed %1 stale entry."
msgid_plural "Removed %1 stale entries."
msgstr[0] "已移除 %1 個過時條目。"

#: src/cli/main.cpp:131
msgid "Unknown command: %1"
msgstr "未知命令：%1"

#. i18n: Command line usage block. Keep the command names untranslated.
#: src/cli/main.cpp:134
msgid ""
"Usage: miryu-app-launcher-cli <command> [args...]\n"
"\n"
"Commands:\n"
"  integrate   <path...>   Integrate AppImages into the desktop\n"
"  unintegrate <path...>   Remove AppImage desktop integration\n"
"  list                    List integrated AppImages (JSON)\n"
"  cleanup                 Remove stale desktop entries"
msgstr ""
"用法：miryu-app-launcher-cli <命令> [參數...]\n"
"\n"
"命令：\n"
"  integrate   <路徑...>   將 AppImage 整合到桌面\n"
"  unintegrate <路徑...>   移除 AppImage 桌面整合\n"
"  list                    列出已整合的 AppImage（JSON 格式）\n"
"  cleanup                 移除過時的桌面條目"

