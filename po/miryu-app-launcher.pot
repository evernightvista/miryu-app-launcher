#: src/launcher/main.cpp:70
msgid "Lean AppImage desktop integration"
msgstr "轻量级 AppImage 桌面集成"

#: src/launcher/main.cpp:73
msgid "Miryu contributors"
msgstr "Miryu 贡献者"

#: src/launcher/main.cpp:78
msgid "Lean AppImage desktop integration for KDE Plasma 6"
msgstr "适用于 KDE Plasma 6 的轻量级 AppImage 桌面集成"

#: src/launcher/main.cpp:81
