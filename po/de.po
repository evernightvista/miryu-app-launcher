#: src/launcher/main.cpp:136
#, kde-format
msgid ""
"<b>Integrate and Run</b> — move the AppImage to %1 and add it to the "
"application menu.\n"
"<b>Run Once</b> — just launch the AppImage now without moving or modifying "
"it."
msgstr ""
"<b>Integrieren und ausführen</b> — AppImage nach %1 verschieben und zum Anwendungsmenü hinzufügen.\n"
"<b>Einmal ausführen</b> — AppImage jetzt nur starten, ohne es zu verschieben oder zu ändern."

#: src/launcher/main.cpp:140
msgid "Integrate and Run"
msgstr "Integrieren und ausführen"

#: src/launcher/main.cpp:141
msgid "Run Once"
msgstr "Einmal ausführen"

